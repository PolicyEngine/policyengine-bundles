{
  "$defs": {
    "ArtifactCertification": {
      "additionalProperties": false,
      "properties": {
        "certified_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certified At"
        },
        "certified_by": {
          "title": "Certified By",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CertificationEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "certified_by"
      ],
      "title": "ArtifactCertification",
      "type": "object"
    },
    "ArtifactRelease": {
      "additionalProperties": false,
      "properties": {
        "release_manifest_sha256": {
          "title": "Release Manifest Sha256",
          "type": "string"
        },
        "release_manifest_uri": {
          "title": "Release Manifest Uri",
          "type": "string"
        },
        "repo_id": {
          "title": "Repo Id",
          "type": "string"
        },
        "repo_type": {
          "default": "model",
          "title": "Repo Type",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "version",
        "release_manifest_uri",
        "release_manifest_sha256"
      ],
      "title": "ArtifactRelease",
      "type": "object"
    },
    "CertificationEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        },
        "signer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signer"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "subject_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Sha256"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CertificationEvidence",
      "type": "object"
    },
    "CompatibilityAssertion": {
      "additionalProperties": false,
      "properties": {
        "asserted_by": {
          "default": "policyengine-bundles",
          "title": "Asserted By",
          "type": "string"
        },
        "basis": {
          "const": "bundle_candidate",
          "default": "bundle_candidate",
          "title": "Basis",
          "type": "string"
        },
        "core_package": {
          "$ref": "#/$defs/PackagePin"
        },
        "data_package": {
          "$ref": "#/$defs/PackageIdentity"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "model_package": {
          "$ref": "#/$defs/PackagePin"
        },
        "release_manifest_sha256": {
          "title": "Release Manifest Sha256",
          "type": "string"
        },
        "release_manifest_uri": {
          "title": "Release Manifest Uri",
          "type": "string"
        }
      },
      "required": [
        "model_package",
        "core_package",
        "data_package",
        "release_manifest_uri",
        "release_manifest_sha256"
      ],
      "title": "CompatibilityAssertion",
      "type": "object"
    },
    "DataArtifact": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "certified",
                  "partially_certified",
                  "hash_pinned"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unverified",
                  "unavailable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "missing_reason": {
                "type": "string"
              }
            },
            "required": [
              "missing_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partially_certified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "certification": {
                "required": [
                  "scopes",
                  "limitations"
                ]
              }
            },
            "required": [
              "certification"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "properties": {
            "uri": {
              "type": "string"
            }
          },
          "required": [
            "uri"
          ]
        },
        {
          "properties": {
            "path": {
              "type": "string"
            },
            "repo_id": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "repo_id",
            "revision"
          ]
        }
      ],
      "properties": {
        "certification": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactCertification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "metadata_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Sha256"
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "preservation_mirrors": {
          "items": {
            "$ref": "#/$defs/PreservationMirror"
          },
          "title": "Preservation Mirrors",
          "type": "array"
        },
        "release_manifest_artifact_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Manifest Artifact Key"
        },
        "repo_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repo Id"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "status": {
          "default": "certified",
          "enum": [
            "certified",
            "partially_certified",
            "hash_pinned",
            "unverified",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DataArtifact",
      "type": "object"
    },
    "DataPackageReference": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "release_manifest_path": {
          "default": "release_manifest.json",
          "title": "Release Manifest Path",
          "type": "string"
        },
        "release_manifest_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Manifest Revision"
        },
        "repo_id": {
          "title": "Repo Id",
          "type": "string"
        },
        "repo_type": {
          "default": "model",
          "title": "Repo Type",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "repo_id"
      ],
      "title": "DataPackageReference",
      "type": "object"
    },
    "PackageIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "PackageIdentity",
      "type": "object"
    },
    "PackagePin": {
      "additionalProperties": false,
      "properties": {
        "git_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Sha"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "resolution_status": {
          "const": "pinned",
          "default": "pinned",
          "title": "Resolution Status",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "runtime_dependency",
                "bundle_carrier"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "sdist_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdist Url"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "wheel_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wheel Url"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "PackagePin",
      "type": "object"
    },
    "PreservationMirror": {
      "additionalProperties": false,
      "properties": {
        "deposited_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deposited At"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "title": "PreservationMirror",
      "type": "object"
    },
    "RegionDataset": {
      "additionalProperties": false,
      "properties": {
        "path_template": {
          "title": "Path Template",
          "type": "string"
        },
        "uri_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri Template"
        }
      },
      "required": [
        "path_template"
      ],
      "title": "RegionDataset",
      "type": "object"
    }
  },
  "$id": "https://policyengine.org/schemas/policyengine-country-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Country-specific package/data compatibility assertion for one PolicyEngine bundle.",
  "properties": {
    "artifact_release": {
      "$ref": "#/$defs/ArtifactRelease"
    },
    "bundle_version": {
      "title": "Bundle Version",
      "type": "string"
    },
    "compatibility": {
      "$ref": "#/$defs/CompatibilityAssertion"
    },
    "core_package": {
      "$ref": "#/$defs/PackagePin"
    },
    "country_id": {
      "title": "Country Id",
      "type": "string"
    },
    "data_package": {
      "$ref": "#/$defs/DataPackageReference"
    },
    "datasets": {
      "additionalProperties": {
        "$ref": "#/$defs/DataArtifact"
      },
      "minProperties": 1,
      "title": "Datasets",
      "type": "object"
    },
    "default_dataset": {
      "title": "Default Dataset",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "model_package": {
      "$ref": "#/$defs/PackagePin"
    },
    "region_datasets": {
      "additionalProperties": {
        "$ref": "#/$defs/RegionDataset"
      },
      "title": "Region Datasets",
      "type": "object"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "bundle_version",
    "country_id",
    "model_package",
    "core_package",
    "data_package",
    "artifact_release",
    "default_dataset",
    "datasets",
    "compatibility"
  ],
  "title": "PolicyEngine country bundle",
  "type": "object"
}
