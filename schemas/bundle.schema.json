{
  "$defs": {
    "InstallTarget": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "title": "Constraints",
          "type": "string"
        },
        "lockfile": {
          "title": "Lockfile",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "resolver": {
          "default": "uv",
          "title": "Resolver",
          "type": "string"
        }
      },
      "required": [
        "python_version",
        "constraints",
        "lockfile"
      ],
      "title": "InstallTarget",
      "type": "object"
    },
    "PackagePin": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "version": {
              "type": "string"
            }
          },
          "required": [
            "version"
          ]
        },
        {
          "properties": {
            "specifier": {
              "type": "string"
            }
          },
          "required": [
            "specifier"
          ]
        }
      ],
      "properties": {
        "git_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Sha"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "resolution_status": {
          "anyOf": [
            {
              "enum": [
                "pinned",
                "specifier_only",
                "unresolved"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Status"
        },
        "sdist_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdist Url"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "specifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specifier"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "wheel_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wheel Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "PackagePin",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "object"
        },
        "countries": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Countries",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "install_targets": {
          "additionalProperties": {
            "$ref": "#/$defs/InstallTarget"
          },
          "title": "Install Targets",
          "type": "object"
        },
        "lockfiles": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Lockfiles",
          "type": "object"
        },
        "packages": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Packages",
          "type": "array"
        }
      },
      "required": [
        "packages",
        "countries"
      ],
      "title": "Profile",
      "type": "object"
    }
  },
  "$id": "https://policyengine.org/schemas/policyengine-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Top-level manifest that maps one policyengine release to certified country profiles, package pins, data manifests, and validation evidence.",
  "properties": {
    "bundle_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bundle Digest"
    },
    "bundle_version": {
      "title": "Bundle Version",
      "type": "string"
    },
    "countries": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Countries",
      "type": "object"
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "packages": {
      "additionalProperties": {
        "$ref": "#/$defs/PackagePin"
      },
      "minProperties": 1,
      "title": "Packages",
      "type": "object"
    },
    "policyengine": {
      "$ref": "#/$defs/PackagePin"
    },
    "profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/Profile"
      },
      "minProperties": 1,
      "title": "Profiles",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "validation_report": {
      "title": "Validation Report",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "bundle_version",
    "policyengine",
    "packages",
    "profiles",
    "countries",
    "validation_report"
  ],
  "title": "PolicyEngine bundle",
  "type": "object"
}
