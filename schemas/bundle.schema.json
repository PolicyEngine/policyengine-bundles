{
  "$defs": {
    "PackagePin": {
      "additionalProperties": false,
      "properties": {
        "git_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Sha"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "resolution_status": {
          "const": "pinned",
          "default": "pinned",
          "title": "Resolution Status",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "runtime_dependency",
                "bundle_carrier"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "sdist_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdist Url"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "wheel_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wheel Url"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "PackagePin",
      "type": "object"
    }
  },
  "$id": "https://policyengine.org/schemas/policyengine-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Top-level manifest that maps one policyengine release to exact package pins and country data release compatibility assertions.",
  "properties": {
    "bundle_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bundle Digest"
    },
    "bundle_version": {
      "title": "Bundle Version",
      "type": "string"
    },
    "countries": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Countries",
      "type": "object"
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "packages": {
      "additionalProperties": {
        "$ref": "#/$defs/PackagePin"
      },
      "minProperties": 1,
      "title": "Packages",
      "type": "object"
    },
    "policyengine": {
      "$ref": "#/$defs/PackagePin"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "validation_report": {
      "title": "Validation Report",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "bundle_version",
    "policyengine",
    "packages",
    "countries",
    "validation_report"
  ],
  "title": "PolicyEngine bundle",
  "type": "object"
}
