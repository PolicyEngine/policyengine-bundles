{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policyengine.org/schemas/policyengine-bundle.schema.json",
  "title": "PolicyEngine bundle",
  "description": "Top-level manifest that maps one policyengine release to certified country profiles, package pins, data manifests, and validation evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_version",
    "policyengine",
    "packages",
    "profiles",
    "countries",
    "validation_report"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bundle_version": {
      "$ref": "#/$defs/version"
    },
    "created_at": {
      "$ref": "#/$defs/date_time"
    },
    "bundle_digest": {
      "$ref": "#/$defs/sha256_with_prefix"
    },
    "policyengine": {
      "$ref": "#/$defs/package_pin"
    },
    "packages": {
      "type": "object",
      "description": "Package pins keyed by normalized package name.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/package_pin"
      }
    },
    "profiles": {
      "type": "object",
      "description": "Install/runtime profiles, such as us, uk, and all.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "countries": {
      "type": "object",
      "description": "Country bundle manifest paths keyed by country id.",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {
          "$ref": "#/$defs/relative_path"
        }
      },
      "additionalProperties": false
    },
    "validation_report": {
      "$ref": "#/$defs/relative_path"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "hash_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "package_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "wheel_url": {
          "type": "string",
          "format": "uri"
        },
        "sdist_url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "$ref": "#/$defs/hash_sha256"
        },
        "git_sha": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packages",
        "countries"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "countries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "locks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/relative_path"
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/relative_path"
          }
        }
      }
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.).+$"
    },
    "sha256_with_prefix": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  }
}
