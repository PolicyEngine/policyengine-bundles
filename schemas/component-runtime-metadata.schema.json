{
  "$defs": {
    "PackagePin": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "version": {
              "type": "string"
            }
          },
          "required": [
            "version"
          ]
        },
        {
          "properties": {
            "specifier": {
              "type": "string"
            }
          },
          "required": [
            "specifier"
          ]
        }
      ],
      "properties": {
        "git_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Sha"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "resolution_status": {
          "anyOf": [
            {
              "enum": [
                "pinned",
                "specifier_only",
                "unresolved"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Status"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "runtime_dependency",
                "bundle_carrier"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "sdist_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdist Url"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "specifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specifier"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "wheel_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wheel Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "PackagePin",
      "type": "object"
    }
  },
  "$id": "https://policyengine.org/schemas/policyengine-component-runtime-metadata.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Dependency-free metadata emitted by component packages for bundle certification.",
  "properties": {
    "core": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackagePin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data_build_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Build Fingerprint"
    },
    "git_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Sha"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "source_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Path"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "wheel_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wheel Sha256"
    },
    "wheel_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wheel Url"
    }
  },
  "required": [
    "name",
    "version"
  ],
  "title": "PolicyEngine component runtime metadata",
  "type": "object"
}
