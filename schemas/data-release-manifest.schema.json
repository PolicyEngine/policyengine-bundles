{
  "$defs": {
    "ArtifactCertification": {
      "additionalProperties": false,
      "properties": {
        "certified_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certified At"
        },
        "certified_by": {
          "title": "Certified By",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CertificationEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "certified_by"
      ],
      "title": "ArtifactCertification",
      "type": "object"
    },
    "CertificationEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        },
        "signer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signer"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "subject_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Sha256"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CertificationEvidence",
      "type": "object"
    },
    "CompatiblePackageSpecifier": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "specifier": {
          "title": "Specifier",
          "type": "string"
        }
      },
      "required": [
        "name",
        "specifier"
      ],
      "title": "CompatiblePackageSpecifier",
      "type": "object"
    },
    "DataArtifact": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "certified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partially_certified",
                  "hash_pinned"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unverified",
                  "unavailable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "missing_reason": {
                "type": "string"
              }
            },
            "required": [
              "missing_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partially_certified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "certification": {
                "required": [
                  "scopes",
                  "limitations"
                ]
              }
            },
            "required": [
              "certification"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "properties": {
            "uri": {
              "type": "string"
            }
          },
          "required": [
            "uri"
          ]
        },
        {
          "properties": {
            "path": {
              "type": "string"
            },
            "repo_id": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "repo_id",
            "revision"
          ]
        }
      ],
      "properties": {
        "certification": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactCertification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "metadata_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Sha256"
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "preservation_mirrors": {
          "items": {
            "$ref": "#/$defs/PreservationMirror"
          },
          "title": "Preservation Mirrors",
          "type": "array"
        },
        "release_manifest_artifact_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release Manifest Artifact Key"
        },
        "repo_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repo Id"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "status": {
          "default": "certified",
          "enum": [
            "certified",
            "partially_certified",
            "hash_pinned",
            "unverified",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DataArtifact",
      "type": "object"
    },
    "DataBuildInfo": {
      "additionalProperties": false,
      "properties": {
        "build_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Id"
        },
        "built_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Built At"
        },
        "built_with_core_package": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeComponentMetadata"
            },
            {
              "$ref": "#/$defs/PackagePin"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Built With Core Package"
        },
        "built_with_model_package": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeComponentMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "title": "DataBuildInfo",
      "type": "object"
    },
    "PackageIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "PackageIdentity",
      "type": "object"
    },
    "PackagePin": {
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "version": {
              "type": "string"
            }
          },
          "required": [
            "version"
          ]
        },
        {
          "properties": {
            "specifier": {
              "type": "string"
            }
          },
          "required": [
            "specifier"
          ]
        }
      ],
      "properties": {
        "git_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Sha"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "resolution_status": {
          "anyOf": [
            {
              "enum": [
                "pinned",
                "specifier_only",
                "unresolved"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Status"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "runtime_dependency",
                "bundle_carrier"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "sdist_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdist Url"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "specifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specifier"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "wheel_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wheel Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "PackagePin",
      "type": "object"
    },
    "PreservationMirror": {
      "additionalProperties": false,
      "properties": {
        "deposited_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deposited At"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "title": "PreservationMirror",
      "type": "object"
    },
    "RuntimeComponentMetadata": {
      "additionalProperties": false,
      "description": "Dependency-free metadata emitted by component packages.",
      "properties": {
        "core": {
          "anyOf": [
            {
              "$ref": "#/$defs/PackagePin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "data_build_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Build Fingerprint"
        },
        "git_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Sha"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "wheel_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wheel Sha256"
        },
        "wheel_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wheel Url"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "RuntimeComponentMetadata",
      "type": "object"
    }
  },
  "$id": "https://policyengine.org/schemas/policyengine-data-release-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Published data-package release contract consumed by bundles.",
  "properties": {
    "artifacts": {
      "additionalProperties": {
        "$ref": "#/$defs/DataArtifact"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "build": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataBuildInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "compatible_core_packages": {
      "items": {
        "$ref": "#/$defs/CompatiblePackageSpecifier"
      },
      "title": "Compatible Core Packages",
      "type": "array"
    },
    "compatible_model_packages": {
      "items": {
        "$ref": "#/$defs/CompatiblePackageSpecifier"
      },
      "title": "Compatible Model Packages",
      "type": "array"
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "data_package": {
      "$ref": "#/$defs/PackageIdentity"
    },
    "default_datasets": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Default Datasets",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "preservation_dois": {
      "items": {
        "type": "string"
      },
      "title": "Preservation Dois",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "data_package"
  ],
  "title": "PolicyEngine data release manifest",
  "type": "object"
}
